PLANPROBE_STATE_DIR=.planprobe

# Local/open-source model route (Ollama, vLLM, or another OpenAI-compatible server)
PLANPROBE_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
PLANPROBE_OPENAI_MODEL=qwen2.5-coder:7b
PLANPROBE_OPENAI_API_KEY=ollama
PLANPROBE_LLM_TIMEOUT_SECONDS=90

# Optional hosted route
ANTHROPIC_API_KEY=
PLANPROBE_ANTHROPIC_MODEL=claude-sonnet-4-5
